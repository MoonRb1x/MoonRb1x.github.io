import "../theme.vcwl"
import "../data.vcwl"
import "../glitch.vcwl"
import "../avatar.vcwl"
import "../figma.vcwl"

export component ContactPage(tick: Int) {
    state copied: Bool = false

    section(label: "Contact") {
        style Wrap
        style {
            padding-top: 72px
        }
        column(gap: 40px) {
            grid(gap: 24px) {
                style {
                    columns: 2
                    when viewport < 900px {
                        columns: 1
                    }
                }
            column(gap: 14px, align: start, justify: center) {
                span("Contact") {
                    style Kicker
                }
                GlitchText(text: "Let's talk.", tick: tick)
                paragraph("The fastest way to reach me is Discord. Send me your game, the screens you need, a few references you like and your deadline.") {
                    style Muted
                    style {
                        margin: 0
                        size: 18px
                        max-width: 600px
                    }
                }
            }
            column(align: center, justify: center) {
                Selected(size: "172 × 240") {
                    box {
                        style {
                            padding: 24px 40px
                        }
                        Avatar(tick: tick, tall: 240)
                    }
                }
            }
            }
            grid(gap: 20px) {
                style {
                    columns: 3
                    when viewport < 900px {
                        columns: 1
                    }
                }
                column(gap: 14px, align: start) {
                    style Card
                    style Lift
                    style {
                        padding: 28px
                    }
                    row(gap: 8px, align: center) {
                        image(src: "images/discord.svg", alt: "Discord") {
                            style {
                                width: 22px
                                height: 22px
                            }
                        }
                        span("Discord") {
                            style Kicker
                        }
                    }
                    span("@{discord_name()}") {
                        style {
                            color: #ffffff
                            weight: 700
                            size: 26px
                        }
                    }
                    button(if copied { "Copied ✓" } else { "Copy username" }) {
                        style ButtonPink
                        on click {
                            copy(discord_name())
                            copied = true
                        }
                    }
                }
                column(gap: 14px, align: start) {
                    style Card
                    style Lift
                    style {
                        padding: 28px
                    }
                    row(gap: 8px, align: center) {
                        image(src: "images/roblox.svg", alt: "Roblox") {
                            style {
                                width: 22px
                                height: 22px
                            }
                        }
                        span("Roblox") {
                            style Kicker
                        }
                    }
                    span("MoonRb1x") {
                        style {
                            color: #ffffff
                            weight: 700
                            size: 26px
                        }
                    }
                    link("View profile ↗", href: roblox_url()) {
                        style ButtonGhost
                    }
                }
                if x_url().len() > 0 {
                    column(gap: 14px, align: start) {
                        style Card
                        style Lift
                        style {
                            padding: 28px
                        }
                        row(gap: 8px, align: center) {
                            span("X") {
                                style {
                                    width: 22px
                                    height: 22px
                                    color: #ffffff
                                    weight: 700
                                    size: 18px
                                }
                            }
                            span("X / Twitter") {
                                style Kicker
                            }
                        }
                        span("DMs open") {
                            style {
                                color: #ffffff
                                weight: 700
                                size: 26px
                            }
                        }
                        link("Message me ↗", href: x_url()) {
                            style ButtonGhost
                        }
                    }
                } else {
                    column(gap: 14px, align: start) {
                        style Card
                        style Lift
                        style {
                            padding: 28px
                        }
                        row(gap: 8px, align: center) {
                            image(src: "images/creator-store.svg", alt: "Creator Store") {
                                style {
                                    width: 22px
                                    height: 22px
                                }
                            }
                            span("Creator Store") {
                                style Kicker
                            }
                        }
                        span("My assets") {
                            style {
                                color: #ffffff
                                weight: 700
                                size: 26px
                            }
                        }
                        link("Browse ↗", href: creator_store_url()) {
                            style ButtonGhost
                        }
                    }
                }
            }
        }
    }
}
