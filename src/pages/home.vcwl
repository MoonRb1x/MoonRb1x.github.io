import "@web"
import "../theme.vcwl"
import "../data.vcwl"
import "../glitch.vcwl"
import "../avatar.vcwl"
import "../figma.vcwl"
import "./work.vcwl"

export component Home(tick: Int) {
    column(gap: 72px, align: center) {
        Hero(tick: tick)
        column(gap: 72px) {
            style Wrap
            Numbers()
            Featured(tick: tick)
            Workflow()
            Services()
            Pitch()
        }
    }
}

fn roles() -> [String] {
    ["Roblox UI Designer", "Shop & inventory maker", "Menus & HUDs", "Creator Store dev"]
}

/// The role line typing itself out, holding, and moving on to the next one.
fn typed(tick: Int) -> String {
    let all = roles()
    let role = all[tick / 48 % all.len()]
    let n = (tick % 48).min(role.len())
    let caret = if tick / 4 % 2 == 0 { "|" } else { " " }
    role.slice(0, n) + caret
}

component Hero(tick: Int) {
    section(label: "Intro", id: "hero") {
        style {
            position: relative
            width: 100%
            min-height: 88vh
        }
        box {
            style {
                when viewport < 1200px {
                    display: none
                }
            }
            box {
                style {
                    position: absolute
                    left: 5%
                    top: 90px
                    opacity: 0.8
                }
                CanvasFrame(name: "Music Player", image: "images/work/02.png", wide: 260)
            }
            box {
                style {
                    position: absolute
                    right: 6%
                    top: 150px
                    opacity: 0.8
                }
                CanvasFrame(name: "Main Menu", image: "images/work/07.png", wide: 150)
            }
            box {
                style {
                    position: absolute
                    left: 6%
                    top: 540px
                }
                Note(text: "Hi! I design Roblox UI. Scroll down for the good stuff.")
            }
            box {
                style {
                    position: absolute
                    right: 5%
                    top: 470px
                    opacity: 0.8
                }
                CanvasFrame(name: "Settings", image: "images/work/01.png", wide: 240)
            }
            Cursor(tick: tick)
        }
        column(gap: 44px, align: center, justify: center) {
            style {
                position: relative
                z: 2
                min-height: 88vh
                padding: 40px 16px 70px
                text-align: center
            }
            Selected(size: "136 × 190") {
                AvatarFull(avatar_width: 136, avatar_height: 190)
            }
            Selected(size: "560 × Hug") {
                column(gap: 16px, align: center) {
                    style {
                        padding: 30px 40px 32px
                        max-width: 560px
                        background: #121117
                        when viewport < 700px {
                            padding: 22px 16px 26px
                        }
                    }
                    row(gap: 8px, align: center) {
                        box {
                            style {
                                width: 8px
                                height: 8px
                                radius: 4px
                                background: #3dff8a
                            }
                        }
                        span("Open for commissions") {
                            style Kicker
                        }
                    }
                    GlitchText(text: "MoonRb1x", tick: tick)
                    span(typed(tick), label: "Roblox UI Designer") {
                        style Mono
                        style {
                            size: 22px
                            color: #ff2bd6
                            min-height: 32px
                            white-space: nowrap
                            when viewport < 500px {
                                size: 17px
                            }
                        }
                    }
                    paragraph("I make game UI that feels good to use. Some projects start in Figma; all are built in Roblox Studio.") {
                        style Muted
                        style {
                            margin: 0
                            size: 17px
                            max-width: 440px
                        }
                    }
                    row(gap: 10px, wrap: yes, justify: center) {
                        link("See my work", to: "/work") {
                            style ButtonPink
                        }
                        link("Commission me", to: "/contact") {
                            style ButtonGhost
                        }
                    }
                }
            }
        }
    }
}

component Numbers {
    Frame(name: "Numbers", anchor: "numbers", size: "Auto layout") {
        grid(gap: 0) {
            style {
                columns: 5
                when viewport < 900px {
                    columns: 2
                }
            }
            Stat(value: "{works().len()}", label: "UIs on show")
            Stat(value: "2019", label: "On Roblox since")
            Stat(value: "Figma", label: "Main Tool")
            Stat(value: "4 years", label: "UI Experience")
            Stat(value: "{items().len()}", label: "Creator Store release")
        }
    }
}

component Stat(value: String, label: String) {
    column(gap: 6px) {
        style {
            padding: 8px 20px 8px 0
        }
        span(label) {
            style Kicker
        }
        span(value) {
            style {
                size: 40px
                weight: 700
                color: #ffffff
                line-height: 1.1
            }
        }
    }
}

component Featured(tick: Int) {
    state open: Int = -1
    state seed: Int = random_int(1, 2147483646)

    let picks = featured_works(seed)

    Frame(name: "Selected work", anchor: "work", size: "3 of {works().len()}") {
        column(gap: 32px) {
            row(justify: between, align: end, wrap: yes, gap: 16px) {
                heading("Screens players remember.", level: 2) {
                    style Title
                }
                link("All {works().len()} projects →", to: "/work") {
                    style ButtonGhost
                }
            }
            grid(gap: 20px) {
                style {
                    columns: 2
                    when viewport < 800px {
                        columns: 1
                    }
                }
                for w in picks key w.id {
                    box {
                        style {
                            position: relative
                            transition: top 1800ms ease-in-out
                        }
                        style bind top: ((tick / 20 + w.id) % 2 * -3) px
                        style if w.id == picks[0].id {
                            when viewport >= 800px {
                                span: 2
                            }
                        }
                        WorkCard(work: w) {
                            on open(id) {
                                open = id
                            }
                        }
                    }
                }
            }
            Note(text: "Figma for the projects that needed a prototype; every screen here was built in Studio.")
        }
        Lightbox(list: picks, id: open) {
            on pick(id) {
                open = id
            }
        }
    }
}

component Workflow {
    Frame(name: "How I work", anchor: "workflow", size: "4 steps") {
        grid(gap: 48px) {
            style {
                columns: 2
                when viewport < 900px {
                    columns: 1
                }
            }
            column(gap: 18px) {
                heading("From first idea to finished UI.", level: 2) {
                    style Title
                }
                paragraph("If a project needs a prototype, I put it together in Figma so you can review the flow. Then I build it in Studio, check different screen sizes and polish the details.") {
                    style Muted
                    style {
                        margin: 0
                        size: 17px
                    }
                }
            }
            column(gap: 0) {
                Step(n: "1", title: "Talk through the game", text: "We pin down the screens, style and how players will use them.")
                Step(n: "2", title: "Plan the flow", text: "When it helps, I make a Figma prototype for you to review.")
                Step(n: "3", title: "Build in Roblox Studio", text: "I put the interface together and check it at different sizes.")
                Step(n: "4", title: "Polish and hand off", text: "I refine the interactions and share the finished files.")
            }
        }
    }
}

/// A step drawn like a row in Figma's layers panel.
component Step(n: String, title: String, text: String) {
    row(gap: 14px, align: start) {
        style {
            padding: 14px 4px
            border-bottom: 1px solid #2c2a35
        }
        span(n) {
            style Mono
            style {
                size: 13px
                color: #00f0ff
                padding: 3px 0 0
                width: 18px
            }
        }
        column(gap: 2px) {
            span(title) {
                style {
                    color: #ffffff
                    weight: 600
                    size: 17px
                }
            }
            span(text) {
                style Muted
                style {
                    size: 15px
                }
            }
        }
    }
}

component Services {
    Frame(name: "Services", anchor: "services", size: "6 components") {
        column(gap: 28px) {
            heading("What I can make for your game.", level: 2) {
                style Title
            }
            grid(gap: 16px) {
                style {
                    columns: 3
                    when viewport < 900px {
                        columns: 2
                    }
                    when viewport < 560px {
                        columns: 1
                    }
                }
                Service(title: "Shops & gamepasses", text: "Stores that sell: clear prices, rarity colours, featured slots.")
                Service(title: "Inventories & indexes", text: "Grids, detail cards, filters, search and collection progress.")
                Service(title: "Settings & menus", text: "Main menus, settings, keybinds and pause screens.")
                Service(title: "Rewards & quests", text: "Daily rewards, quests, spins and anything with a claim button.")
                Service(title: "HUDs", text: "Currency bars, music players, notifications and toasts.")
                Service(title: "Icons & buttons", text: "Matching icon sets and button kits for your whole game.")
            }
        }
    }
}

component Service(title: String, text: String) {
    column(gap: 10px, align: start) {
        style Card
        style Lift
        style {
            padding: 20px
        }
        span("◇ {title}") {
            style Tag
        }
        span(text) {
            style Muted
            style {
                size: 15px
            }
        }
    }
}

component Pitch {
    Frame(name: "Commission", anchor: "commission") {
        column(gap: 18px, align: center) {
            style {
                padding: 40px 0
                text-align: center
            }
            span("Open for commissions") {
                style Kicker
            }
            heading("Got a game that needs a UI?", level: 2) {
                style Title
                style {
                    size: 56px
                    when viewport < 700px {
                        size: 36px
                    }
                }
            }
            paragraph("Tell me about your game and the screens you need.") {
                style Muted
                style {
                    margin: 0
                    size: 18px
                }
            }
            link("Let's talk", to: "/contact") {
                style ButtonPink
            }
        }
    }
}
