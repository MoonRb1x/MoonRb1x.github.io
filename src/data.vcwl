fn contains_work(list: [Work], id: Int) -> Bool {
    for work in list {
        if work.id == id {
            return true
        }
    }
    false
}

fn add_featured(list: [Work], work: Work) -> [Work] {
    if list.len() < 3 && !contains_work(list, work.id) {
        list.push(work)
    } else {
        list
    }
}

export fn featured_works(seed: Int) -> [Work] {
    let all = works()
    var chosen: [Work] = []
    var value = seed
    for attempt in 0..40 {
        value = (value * 48271 + attempt + 1) % 2147483647
        chosen = add_featured(chosen, all[value % all.len()])
    }
    chosen
}

export fn kinds() -> [String] {
    ["All", "Shops", "Systems", "Menus", "HUD"]
}

export fn works_of(kind: String) -> [Work] {
    var out: [Work] = []
    for w in works() {
        if kind == "All" || w.kind == kind {
            out = out.push(w)
        }
    }
    out
}

