fn picked(works: [Work], id: Int) -> Bool {
    for work in works {
        if work.id == id {
            return true
        }
    }
    false
}

export fn featured_works(seed: Int) -> [Work] {
    let all = works()
    var chosen: [Work] = []
    var value = seed
    for attempt in 0..40 {
        value = (value * 48271 + 1) % 2147483647
        let candidate = all[value % all.len()]
        if chosen.len() < 3 && !picked(chosen, candidate.id) {
            chosen = chosen.push(candidate)
        }
    }
    chosen
}

export fn kinds() -> [String] {
    ["All", "Shops", "Systems", "Menus", "HUD"]
}

export fn works_of(kind: String) -> [Work] {
    var out: [Work] = []
    for w in works() {
        if kind == "All" || w.kind == kind {
            out = out.push(w)
        }
    }
    out
}

