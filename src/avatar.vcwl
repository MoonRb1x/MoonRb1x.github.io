import "./glitch.vcwl"

export component Avatar(tick: Int, tall: Int) {
    box {
        style bind width: tall px
        style bind height: tall px
        style {
            position: relative
            radius: 50%
            overflow: hidden
            border: 3px solid #ff2bd6
            background: #2a2140
        }
        image(src: "images/avatar.png", alt: "MoonRb1x's Roblox avatar") {
            style {
                display: block
                width: 100%
                height: 100%
                fit: cover
                transition: transform 700ms spring
                when hover {
                    transform: scale(1.06) rotate(-3deg)
                }
            }
        }
        GlitchBars(tick: tick + 5, count: 6)
    }
}
