export component AvatarFull(avatar_width: Int, avatar_height: Int) {
    image(src: "images/avatar-full.png", alt: "MoonRb1x's full Roblox avatar") {
        style {
            display: block
            fit: contain
        }
        style bind width: avatar_width px
        style bind height: avatar_height px
    }
}

export component AvatarMark(size: Int, outlined: Bool) {
    box {
        style bind width: size px
        style bind height: size px
        style {
            display: block
            radius: 50%
            overflow: hidden
            background: #2a2140
        }
        style if outlined {
            border: 2px solid #ff2bd6
        }
        image(src: "images/avatar.png", alt: "") {
            style {
                display: block
                width: 100%
                height: 100%
                fit: cover
                radius: 50%
            }
        }
    }
}
